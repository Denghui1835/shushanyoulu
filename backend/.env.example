# 书山有路 - 环境配置
# 复制为 .env 并填入你的值

# LLM API Key（至少填一个，默认 DeepSeek）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# 或使用 Anthropic（可选）
# ANTHROPIC_AUTH_TOKEN=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_MODEL=claude-sonnet-4-5

# 数据库（默认本地 SQLite）
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ============================================================
# AI 播客 · TTS（生成双主播音频）
# 默认 edge = 免费免 Key（开源 edge-tts 包，走微软 Edge 在线神经语音，需联网）。
# 不用填任何 Key 就能用；想换音色改下面两个 voice 即可。
# 备选付费 provider：volc（火山引擎/豆包）/ azure / mock（无声占位，纯链路测试）。
# ============================================================
TTS_PROVIDER=edge
# 两位主播音色（主播A 女声 / 主播B 男声），edge-tts 支持的 zh-CN 音色见
#   python -m edge_tts --list-voices
EDGE_TTS_VOICE_A=zh-CN-XiaoxiaoNeural
EDGE_TTS_VOICE_B=zh-CN-YunxiNeural

# --- 火山引擎 / 字节豆包 TTS（付费，可选）---
# 开通地址：火山引擎控制台 → 语音技术 → 语音合成（大模型音色）
# 需开通「豆包语音合成/大模型语音合成」服务；AppID 与访问令牌在应用信息里
# VOLC_APP_ID=
# VOLC_ACCESS_TOKEN=
# VOLC_TTS_CLUSTER=volcano_mega
# VOLC_TTS_VOICE_A=BV001_streaming
# VOLC_TTS_VOICE_B=BV700_streaming

# --- Azure 认知服务 TTS（付费，可选）---
# AZURE_TTS_KEY=
# AZURE_TTS_REGION=eastasia
# AZURE_TTS_VOICE_A=zh-CN-XiaoxiaoNeural
# AZURE_TTS_VOICE_B=zh-CN-YunxiNeural

# ============================================================
# 微信登录（预留，未配置时微信登录接口返回明确错误）
# 需在微信开放平台创建小程序/网站应用，获取 AppID 与 Secret
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=

# 用户自有 API Key 加密密钥（fernet，建议固定设置；留空则每次启动随机生成，重启后旧 Key 失效）
# API_KEY_ENCRYPT_SECRET=

# TTS provider：edge（默认免费）/ volc_mega（豆包大模型音色）/ volc_standard（豆包普通音色）/ azure / mock
# TTS_PROVIDER=edge

# ============================================================
# 作品社区（项目分享）
# 把导出的 .yqp 文件放到共享位置（网盘/GitHub 仓库），
# 再写一个 catalog.json 并填它的直链（raw），社区页即可浏览/一键导入。
# catalog.json 格式：{"items": [{"title":..., "description":..., "author":...,
#   "icon":..., "file_url": "https://.../xxx.yqp", "updated_at": "2026-08-02"}]}
# ============================================================
# COMMUNITY_CATALOG_URL=https://raw.githubusercontent.com/你的仓库/main/catalog.json
